FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum* ./

# Download dependencies
RUN {{.InstallCommand}}

# Copy source code
COPY . .

{{if .BuildCommand}}
# Build application (builds static binary for Alpine)
RUN CGO_ENABLED=0 GOOS=linux {{.BuildCommand}}
{{end}}

# Production stage
FROM alpine:latest

WORKDIR /app

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

# Copy built binary and any config files from builder
# The binary location depends on build command (e.g., ./app, ./bin/app, etc.)
COPY --from=builder /app .

# Set PORT environment variable
ENV PORT={{.Port}}

# Expose port
EXPOSE {{.Port}}

# Run application (specify path to binary, e.g., ./app or ./bin/app)
CMD ["/bin/sh", "-c", "{{.RunCommand}}"]
