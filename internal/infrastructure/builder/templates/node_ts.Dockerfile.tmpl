FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files and TypeScript config
COPY package*.json ./
COPY tsconfig*.json ./

# Install dependencies
RUN {{.InstallCommand}}

# Copy source code
COPY . .

{{if .BuildCommand}}
# Build TypeScript application
RUN {{.BuildCommand}}
{{end}}

# Production stage
FROM node:18-alpine

WORKDIR /app

# Copy built artifacts from builder (includes node_modules and compiled output)
COPY --from=builder /app .

# Set PORT environment variable
ENV PORT={{.Port}}

# Expose port
EXPOSE {{.Port}}

# Run application
CMD ["/bin/sh", "-c", "{{.RunCommand}}"]
