FROM node:18-alpine AS deps

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN {{.InstallCommand}}

# Builder stage
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Set environment to production
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

{{if .BuildCommand}}
# Build Next.js application
RUN {{.BuildCommand}}
{{end}}

# Production stage
FROM node:18-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy package files for non-standalone mode
COPY --from=builder /app/package*.json ./

# Copy node_modules for non-standalone mode (needed if not using standalone output)
COPY --from=builder /app/node_modules ./node_modules

# Copy public assets
COPY --from=builder /app/public ./public

# Copy Next.js build output
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next

# Copy next.config.js if it exists (needed for runtime)
COPY --from=builder /app/next.config.* ./

USER nextjs

EXPOSE {{.Port}}

ENV PORT={{.Port}}
ENV HOSTNAME="0.0.0.0"

# Run application (use "node server.js" for standalone, "npm start" for standard)
CMD ["/bin/sh", "-c", "{{.RunCommand}}"]
